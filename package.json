{
  "name": "dsh-plugin-weather",
  "version": "0.4.1",
  "description": "Global weather, multi-day forecast and air quality for DeepSeek Harness, Claude Code, Codex, Cursor and any MCP/shell agent — temperature, feels-like, humidity, UV index, sunrise/sunset, wind, PM2.5/AQI, in 9 languages. Open-Meteo, no API key.",
  "license": "MIT",
  "author": "Vaughn <whaoran1018@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whaoran1018-cmd/dsh-plugin-weather.git"
  },
  "homepage": "https://github.com/whaoran1018-cmd/dsh-plugin-weather#readme",
  "bugs": {
    "url": "https://github.com/whaoran1018-cmd/dsh-plugin-weather/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./mcp": {
      "default": "./bin/mcp-server.mjs"
    },
    "./cli": {
      "default": "./bin/cli.mjs"
    },
    "./harness": {
      "default": "./lib/harness.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-weather": "bin/cli.mjs",
    "dsh-weather-mcp": "bin/mcp-server.mjs",
    "dsh-weather-schemas": "bin/schemas.mjs"
  },
  "files": [
    "lib",
    "bin",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "weather",
    "forecast",
    "air-quality",
    "aqi",
    "uv-index",
    "sunrise",
    "sunset",
    "wind",
    "open-meteo",
    "i18n",
    "multilingual",
    "中文",
    "日本語",
    "한국어"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node test/selftest.mjs --offline",
    "test:live": "node test/selftest.mjs",
    "test:mcp": "node test/mcp-test.mjs",
    "test:cli": "node test/cli-test.mjs",
    "test:i18n": "node test/i18n-test.mjs",
    "test:schema": "node tools/verify-schema-subset.mjs",
    "test:all": "node test/selftest.mjs --offline && node test/mcp-test.mjs --offline && node test/cli-test.mjs --offline && node test/i18n-test.mjs --offline && node tools/verify-schema-subset.mjs",
    "test:all:live": "node test/selftest.mjs && node test/mcp-test.mjs && node test/cli-test.mjs && node test/i18n-test.mjs",
    "export:schemas": "node tools/export-schemas.mjs",
    "verify": "powershell -File tools/verify.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
